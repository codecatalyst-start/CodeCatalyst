    {
      "parameters": {
        "jsCode": "// Static / heuristic checks on the PR.\n// Replace this block with a real call to ESLint/SonarQube/etc. (HTTP Request node)\n// if you want an actual static analysis engine instead of these heuristics.\nconst data = $json;\nconst staticIssues = [];\n\nif (!data.isValid) {\n  staticIssues.push(...data.validationErrors);\n}\n\nif (data.changedFiles !== null && data.changedFiles > 50) {\n  staticIssues.push(`PR touches ${data.changedFiles} files - request smaller, focused PRs`);\n}\n\nconst totalLines = (data.additions || 0) + (data.deletions || 0);\nif (totalLines > 1000) {\n  staticIssues.push(`PR changes ${totalLines} lines - consider splitting it up`);\n}\n\nif (/\\b(TODO|FIXME)\\b/i.test(data.body)) {\n  staticIssues.push('PR description contains unresolved TODO/FIXME markers');\n}\n\nreturn [{\n  json: {\n    ...data,\n    staticValidationPassed: staticIssues.length === 0,\n    staticIssues\n  }\n}];"
      },
