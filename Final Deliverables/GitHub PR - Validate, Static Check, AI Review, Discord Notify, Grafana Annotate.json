    {
      "parameters": {
        "jsCode": "// ---------------------------------------------------------\n// Generic GitHub Event Normalizer\n// Supports:\n//  - pull_request\n//  - push\n//  - issues\n//  - release\n//  - unknown events\n// ---------------------------------------------------------\n\nconst payload = $json.body || {};\nconst headers = $json.headers || {};\nconst validationErrors = [];\n// Detect GitHub Event\nconst eventType =\n  headers[\"x-github-event\"] ||\n  headers[\"X-GitHub-Event\"] ||\n  \"unknown\";\n\n// Common Repository Information\nconst repository =\n  payload.repository?.name || \"\";\n\nconst owner =\n  payload.repository?.owner?.login ||\n  payload.repository?.owner?.name ||\n  \"\";\n\nconst sender =\n  payload.sender?.login ||\n  payload.sender?.name ||\n  \"unknown\";\n\n// Default normalized object\nconst eventData = {\n  eventType,\n  action: payload.action || \"N/A\",\n\n  repository,\n  owner,\n  sender,\n\n  isValid: true,\n  validationErrors\n};\n\n// ---------------------------------------------------------\n// Pull Request Event\n// ---------------------------------------------------------\nif (eventType === \"pull_request\") {\n\n  const pr = payload.pull_request || {};\n\n  Object.assign(eventData, {\n\n    prNumber: pr.number ?? null,\n\n    title: (pr.title || \"\").trim(),\n\n    body: (pr.body || \"\").trim(),\n\n    author:\n      pr.user?.login || \"unknown\",\n\n    baseBranch:\n      pr.base?.ref || \"\",\n\n    headBranch:\n      pr.head?.ref || \"\",\n\n    draft:\n      pr.draft ?? false,\n\n    diffUrl:\n      pr.diff_url || \"\",\n\n    htmlUrl:\n      pr.html_url || \"\",\n\n    changedFiles:\n      pr.changed_files ?? 0,\n\n    additions:\n      pr.additions ?? 0,\n\n    deletions:\n      pr.deletions ?? 0\n  });\n\n  if (!eventData.title)\n    validationErrors.push(\"PR title is empty\");\n\n  if (!eventData.baseBranch)\n    validationErrors.push(\"Base branch missing\");\n\n  if (!eventData.headBranch)\n    validationErrors.push(\"Head branch missing\");\n\n  if (eventData.prNumber === null)\n    validationErrors.push(\"PR number missing\");\n}\n\n// ---------------------------------------------------------\n// Push Event\n// ---------------------------------------------------------\nelse if (eventType === \"push\") {\n\n  Object.assign(eventData, {\n\n    branch:\n      payload.ref?.replace(\"refs/heads/\", \"\") || \"\",\n\n    before:\n      payload.before || \"\",\n\n    after:\n      payload.after || \"\",\n\n    commitCount:\n      payload.commits?.length || 0,\n\n    commits:\n      payload.commits || [],\n\n    headCommitMessage:\n      payload.head_commit?.message || \"\",\n\n    headCommitId:\n      payload.head_commit?.id || \"\",\n\n    pusher:\n      payload.pusher?.name || \"\",\n\n    compareUrl:\n      payload.compare || \"\"\n  });\n\n  if (!eventData.branch)\n    validationErrors.push(\"Branch missing\");\n\n  if (eventData.commitCount === 0)\n    validationErrors.push(\"No commits found\");\n}\n\n// ---------------------------------------------------------\n// Issues Event\n// ---------------------------------------------------------\nelse if (eventType === \"issues\") {\n\n  const issue = payload.issue || {};\n\n  Object.assign(eventData, {\n\n    issueNumber:\n      issue.number ?? null,\n\n    title:\n      issue.title || \"\",\n\n    body:\n      issue.body || \"\",\n\n    state:\n      issue.state || \"\",\n\n    htmlUrl:\n      issue.html_url || \"\"\n  });\n\n  if (!eventData.title)\n    validationErrors.push(\"Issue title missing\");\n}\n\n// ---------------------------------------------------------\n// Release Event\n// ---------------------------------------------------------\nelse if (eventType === \"release\") {\n\n  const release = payload.release || {};\n\n  Object.assign(eventData, {\n\n    tag:\n      release.tag_name || \"\",\n\n    releaseName:\n      release.name || \"\",\n\n    draft:\n      release.draft ?? false,\n\n    prerelease:\n      release.prerelease ?? false,\n\n    htmlUrl:\n      release.html_url || \"\"\n  });\n\n  if (!eventData.tag)\n    validationErrors.push(\"Release tag missing\");\n}\n\n// ---------------------------------------------------------\n// Unknown Event\n// ---------------------------------------------------------\nelse {\n\n  Object.assign(eventData, {\n    rawPayload: payload\n  });\n\n  eventData.validationErrors.push(\n    `Unsupported GitHub event: ${eventType}`\n  );\n}\n\n// ---------------------------------------------------------\n// Common Validation\n// ---------------------------------------------------------\n\nif (!repository) {\n  validationErrors.push(\"Repository missing\");\n}\n\nif (!owner) {\n  validationErrors.push(\"Repository owner missing\");\n}\n\neventData.isValid =\n  validationErrors.length === 0;\n\n// ---------------------------------------------------------\n// Return Normalized Event\n// ---------------------------------------------------------\n\nreturn [{\n  json: eventData\n}];"
      },
      "id": "7baf56d8-111f-4b29-af0e-ba8b62ed7de7",
      "name": "Validate PR Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1168,
        224
