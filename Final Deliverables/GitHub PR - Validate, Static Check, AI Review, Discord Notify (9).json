    {
      "parameters": {
        "jsCode": "// Parse the AI Agent's JSON response, tolerant of accidental code fences\nconst raw = ($json.output || $json.text || $json.response || '').toString().trim();\nconst cleaned = raw.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```\\s*$/, '').trim();\n\nlet review;\ntry {\n  review = JSON.parse(cleaned);\n} catch (e) {\n  review = {\n    summary: cleaned,\n    riskLevel: 'UNKNOWN',\n    strengths: [],\n    concerns: [],\n    suggestedNextSteps: []\n  };\n}\n\nreturn [{\n  json: {\n    //prNumber: $('Static Code Validation').first().json.prNumber,\n    commitid: $('Log Event').first().json.commit_id,\n    title: $('Static Code Validation').first().json.title,\n    author: $('Log Event').first().json.author,\n    htmlUrl: $('Static Code Validation').first().json.htmlUrl,\n    aiSummary: review.summary,\n    aiRiskLevel: review.riskLevel,\n    aiStrengths: review.strengths,\n    aiConcerns: review.concerns,\n    aiNextSteps: review.suggestedNextSteps,\n    reviewedAt: new Date().toISOString()\n  }\n}];"
      },
