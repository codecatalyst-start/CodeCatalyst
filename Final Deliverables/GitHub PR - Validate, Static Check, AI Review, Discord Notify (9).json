      "id": "8572c2df-92f6-4667-8154-2e363c86db52",
      "name": "GitHub Pull Request Trigger",
      "type": "n8n-nodes-base.githubTrigger",
      "typeVersion": 1,
      "position": [
        -1392,
        224
      ],
      "webhookId": "e1a2b3c4-0001-webhook-000000000001",
      "alwaysOutputData": true,
